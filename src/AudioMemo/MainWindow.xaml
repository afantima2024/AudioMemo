<Window x:Class="AudioMemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioMemo.Localization"
        xmlns:controls="clr-namespace:AudioMemo.Controls"
        xmlns:services="clr-namespace:AudioMemo.Services"
        Title="{loc:Loc MainWindowTitle}" Width="1440" Height="900" MinWidth="640" MinHeight="420"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing"
        SizeChanged="Workspace_SizeChanged" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border Background="{TemplateBinding Background}">
                <AdornerDecorator><ContentPresenter /></AdornerDecorator>
            </Border>
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <Style x:Key="CaptionKeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="3" BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CaptionKeyboardFocus}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="close" /><Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Opacity" Value="0.75" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="WindowHeader" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1"
                SizeChanged="WindowHeader_SizeChanged">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="WindowButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click"
                            ToolTip="{loc:Loc WindowMinimize}" AutomationProperties.Name="{loc:Loc WindowMinimize}">
                        <Path Data="M0,5 L10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow_Click"
                            ToolTip="{loc:Loc WindowMaximize}" AutomationProperties.Name="{loc:Loc WindowMaximize}">
                        <Path x:Name="MaximizeWindowGlyph" Data="M0.5,0.5 L9.5,0.5 9.5,9.5 0.5,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Tag="close" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click"
                            ToolTip="{loc:Loc CloseAudioMemo}" AutomationProperties.Name="{loc:Loc CloseAudioMemo}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            <DockPanel x:Name="HeaderControls" Margin="14,7,8,7">
                <TextBlock x:Name="ActiveModelText" DockPanel.Dock="Bottom" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox x:Name="MainSpeechLanguageBox" DockPanel.Dock="Right" Width="164" MinHeight="30" Padding="6,3" FontSize="12"
                          Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="False" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectionChanged="MainSpeechLanguage_SelectionChanged" ToolTip="{loc:Loc MainSpeechLanguageHint}"
                          ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc RecordingLanguage}" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="AppMenuButton" DockPanel.Dock="Left" Style="{StaticResource CaptionButton}"
                        Width="36" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" Click="AppMenu_Click"
                        ToolTip="{loc:Loc ApplicationMenu}" AutomationProperties.Name="{loc:Loc ApplicationMenu}">
                    <Image x:Name="BrandLogo" Source="{x:Static services:AppIcons.Logo}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Focusable="False"
                           AutomationProperties.Name="AudioMemo" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AppMenu" Opened="AppMenu_Opened">
                            <MenuItem x:Name="AppNewRecordingMenu" Header="{loc:Loc NewConversationButton}" Tag="new" Click="AppCommand_Click" />
                            <MenuItem x:Name="AppRecordMenu" Header="{loc:Loc StartRecording}" Tag="record" Click="AppCommand_Click" />
                            <MenuItem x:Name="AppStopMenu" Header="{loc:Loc Stop}" Tag="stop" Click="AppCommand_Click" />
                            <Separator />
                            <MenuItem x:Name="AppImportMenu" Header="{loc:Loc ImportAudio}" Tag="import" Click="AppCommand_Click" />
                            <MenuItem x:Name="AppOpenFolderMenu" Header="{loc:Loc OpenSavingFolder}" Tag="library" Click="AppCommand_Click" />
                            <Separator />
                            <MenuItem x:Name="AppHistoryMenu" Header="{loc:Loc PinRecordingList}" Tag="history" Click="ToggleHistory_Click"
                                      StaysOpenOnClick="True" />
                            <MenuItem x:Name="AppMainPointsMenu" Header="{loc:Loc ShowMainPoints}" Tag="summary" Click="PaneVisibility_Click"
                                      IsCheckable="True" StaysOpenOnClick="True" />
                            <MenuItem x:Name="AppMyNotesMenu" Header="{loc:Loc ShowMyNotes}" Tag="notes" Click="PaneVisibility_Click"
                                      IsCheckable="True" StaysOpenOnClick="True" />
                            <Separator />
                            <MenuItem x:Name="AppSettingsMenu" Header="{loc:Loc Settings}" Click="Settings_Click" />
                            <MenuItem x:Name="AppMessageHistoryMenu" Header="{loc:Loc MessageHistory}" Click="MessageHistory_Click"
                                      ToolTip="{loc:Loc MessageHistoryHint}" />
                            <MenuItem x:Name="AppHelpMenu" Header="{loc:Loc HelpAndAbout}" Click="Help_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="BrandText" DockPanel.Dock="Left" Text="AudioMemo" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" />
                <WrapPanel WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="ProviderLabel" Text="{loc:Loc LlmLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                    <ComboBox x:Name="MainProviderBox" DisplayMemberPath="Label" SelectedValuePath="Code" Width="190"
                              ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                              SelectionChanged="MainProvider_SelectionChanged" AutomationProperties.Name="{loc:Loc LlmLabel}" />
                    <ComboBox x:Name="MainModelBox" IsEditable="True" Width="245" Margin="6,0,0,0"
                              AutomationProperties.Name="{loc:Loc SummaryModel}" />
                    <Button x:Name="ApplyModelButton" Content="{loc:Loc ApplyModel}" Click="ApplyModel_Click" MinHeight="30" Padding="9,4" Margin="6,0,0,0"
                            ToolTip="{loc:Loc LlmValidationNotice}" />
                    <Button x:Name="RefreshModelButton" Content="{loc:Loc RefreshList}" Click="RefreshMainModels_Click" MinHeight="30" Padding="9,4" Margin="6,0,0,0" />
                </WrapPanel>
            </DockPanel>
            </Grid>
        </Border>
        <Grid x:Name="WorkspaceBody" Grid.Row="1" SizeChanged="HistoryBody_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryColumn" Width="210" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="HistoryPeekTab" Grid.ColumnSpan="2" Visibility="Collapsed" Content="&gt;" Width="30" Height="30" MinHeight="30" MinWidth="0" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0" Panel.ZIndex="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Click="RevealHistory" MouseEnter="RevealHistory" MouseLeave="History_PointerChanged"
                    PreviewMouseLeftButtonDown="HistoryTab_MouseDown" PreviewMouseMove="HistoryTab_MouseMove"
                    PreviewMouseLeftButtonUp="HistoryTab_MouseUp" LostMouseCapture="HistoryTab_LostCapture" PreviewKeyDown="HistoryTab_KeyDown"
                    ToolTip="{loc:Loc HistoryPeekHint}" AutomationProperties.Name="{loc:Loc PreviewRecordings}" />
            <Border x:Name="HistoryPanel" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="10,12"
                    Panel.ZIndex="10" MouseEnter="History_PointerChanged" MouseLeave="History_PointerChanged"
                    PreviewMouseDown="History_Activity" PreviewMouseWheel="History_Activity" PreviewKeyDown="History_Activity">
                <Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="PinHistoryButton" DockPanel.Dock="Right" Content="{loc:Loc PinHistory}"
                                    Click="ToggleHistory_Click" Padding="5,2" MinHeight="24" FontSize="11" ToolTip="{loc:Loc PinHistoryHint}" />
                            <TextBlock Text="{loc:Loc YourRecordings}" FontWeight="SemiBold" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <CheckBox x:Name="SelectAllHistoryCheck" DockPanel.Dock="Left" Content="{loc:Loc SelectAllRecordingsShort}"
                                      IsThreeState="True" IsEnabled="False" Click="SelectAllHistory_Click" FontSize="11"
                                      Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{loc:Loc SelectAllRecordings}"
                                      AutomationProperties.Name="{loc:Loc SelectAllRecordings}" />
                            <TextBlock x:Name="LibraryHint" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                                       TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.Resources>
                            <DataTemplate x:Key="HistoryActionCaption">
                                <TextBlock Text="{Binding}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button x:Name="ImportAudioButton" Content="{loc:Loc ImportAudio}" Click="ImportAudio_Click"
                                ContentTemplate="{StaticResource HistoryActionCaption}" HorizontalContentAlignment="Stretch"
                                Padding="8,4" MinHeight="30" FontSize="12" ToolTip="{loc:Loc ImportAudio}" />
                        <Button x:Name="OpenLibraryButton" Grid.Column="2" Content="{loc:Loc OpenSavingFolder}" Click="OpenLibrary_Click"
                                ContentTemplate="{StaticResource HistoryActionCaption}" HorizontalContentAlignment="Stretch"
                                FontSize="12" Padding="8,5" ToolTip="{loc:Loc OpenSavingFolder}" />
                    </Grid>
                    <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                             SelectionChanged="History_SelectionChanged" ToolTip="{loc:Loc HistorySelectionHint}"
                             PreviewMouseRightButtonDown="History_RightClick" ContextMenuOpening="History_ContextMenuOpening"
                             ContextMenuService.ShowOnDisabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc SavedRecordings}"
                             AutomationProperties.HelpText="{loc:Loc HistorySelectionHint}">
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.SelectAll" CanExecute="SelectAllHistory_CanExecute"
                                            Executed="SelectAllHistory_Executed" />
                        </ListBox.CommandBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu MouseEnter="History_PointerChanged" MouseLeave="History_PointerChanged"
                                         PreviewMouseDown="History_Activity" PreviewKeyDown="History_Activity" PreviewMouseWheel="History_Activity"
                                         Closed="HistoryMenu_Closed">
                                <MenuItem x:Name="ContinueRecordingMenu" Header="{loc:Loc ContinueRecording}" Click="Start_Click" />
                                <MenuItem x:Name="RenameSessionMenu" Header="{loc:Loc RenameSession}" Click="RenameSession_Click" />
                                <MenuItem x:Name="OpenSessionMenu" Header="{loc:Loc OpenFiles}" Click="OpenSession_Click" />
                                <MenuItem x:Name="RecoverSessionMenu" Header="{loc:Loc RecoverWave}" Click="Recover_Click" />
                                <MenuItem x:Name="CopySessionMenu" Header="{loc:Loc CopyAllText}" Click="CopySessionText_Click" />
                                <MenuItem x:Name="ExportTranscriptMenu" Header="{loc:Loc ExportTranscript}" Click="ExportTranscript_Click" />
                                <MenuItem x:Name="RestoreSilenceMenu" Header="{loc:Loc RestoreMutedSections}" Click="RestoreSilence_Click" />
                                <Separator />
                                <MenuItem x:Name="TranscribeSessionMenu" Header="{loc:Loc TranscribeResume}" Click="Transcribe_Click" />
                                <MenuItem x:Name="IdentifySpeakersMenu" Header="{loc:Loc IdentifySpeakers}" Click="IdentifySpeakers_Click" />
                                <MenuItem x:Name="RecheckUnlabeledSpeakersMenu" Header="{loc:Loc RecheckUnlabeledSpeakers}" Click="RecheckUnlabeledSpeakers_Click"
                                          ToolTip="{loc:Loc RecheckUnlabeledHint}" />
                                <MenuItem x:Name="SummarizeSessionMenu" Header="{loc:Loc UpdateMainPoints}" Click="Summarize_Click" />
                                <MenuItem x:Name="ExportMp3Menu" Header="{loc:Loc ExportMp3}" Click="ExportMp3_Click" />
                                <Separator />
                                <MenuItem x:Name="DeleteSessionMenu" Header="{loc:Loc RecycleSession}" Click="DeleteSession_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                <Setter Property="Padding" Value="7,8" /><Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Status, Converter={StaticResource SessionStatusConverter}}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Thumb x:Name="HistoryResizeGrip" Width="7" HorizontalAlignment="Right" Margin="0,-12,-10,-12"
                       Cursor="SizeWE" Focusable="True" DragStarted="HistoryWidth_DragStarted" DragDelta="HistoryWidth_DragDelta"
                       DragCompleted="HistoryWidth_DragCompleted" PreviewKeyDown="HistoryWidth_KeyDown"
                       ToolTip="{loc:Loc ResizeHistoryHint}" AutomationProperties.Name="{loc:Loc ResizeHistory}">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Border x:Name="DividerLine" Background="{DynamicResource AppDivider}" Width="2"
                                        HorizontalAlignment="Right" SnapsToDevicePixels="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                </Grid>
            </Border>
            <ScrollViewer x:Name="WorkspaceScroller" Grid.Column="1" Margin="12,8,12,8" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <Grid x:Name="WorkspaceContent" MinWidth="580" MinHeight="360" Width="{Binding ViewportWidth, ElementName=WorkspaceScroller}"
                  Height="{Binding ViewportHeight, ElementName=WorkspaceScroller}" SizeChanged="Workspace_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="NewButton" DockPanel.Dock="Left" Content="{loc:Loc NewConversationButton}" Click="New_Click" Padding="8,4" MinHeight="30" FontSize="12" Margin="0,0,10,0" />
                    <Button x:Name="OpenSessionButton" DockPanel.Dock="Right" Content="{loc:Loc OpenFiles}" Click="OpenSession_Click" Padding="8,4" MinHeight="30" FontSize="12" Margin="8,0,0,0" />
                    <Button x:Name="RecoverButton" DockPanel.Dock="Right" Content="{loc:Loc RecoverWave}" Click="Recover_Click" Visibility="Collapsed" Padding="8,4" MinHeight="30" FontSize="12" Margin="8,0,0,0" />
                    <TextBlock x:Name="TimerText" DockPanel.Dock="Right" Text="00:00:00" FontFamily="Cascadia Mono, Consolas" FontSize="22" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="{loc:Loc RecordingDuration}" />
                    <TextBlock x:Name="WorkspaceSubtitle" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Grid>
                        <TextBlock x:Name="WorkspaceTitle" Text="{loc:Loc WorkspaceTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <DockPanel x:Name="CompactPanePicker" Visibility="Collapsed" ToolTip="{Binding Text, ElementName=WorkspaceTitle}">
                            <ComboBox x:Name="CompactPaneBox" MaxWidth="220" MinHeight="28" Padding="7,3" DisplayMemberPath="Label" SelectedValuePath="Code"
                                      SelectionChanged="CompactPane_SelectionChanged" AutomationProperties.Name="{loc:Loc ReadingPane}" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:Name="DeviceBar">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="DeviceSelectors">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="MicEnabled" Content="{loc:Loc Microphone}" FontSize="12" Margin="0,0,6,0" Click="DeviceEnabled_Click" />
                            <ComboBox x:Name="MicDevice" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="28" Padding="5,3" SelectionChanged="Device_SelectionChanged" ToolTip="{loc:Loc DevicesHint}" AutomationProperties.Name="{loc:Loc MicrophoneDevice}" />
                            <CheckBox x:Name="PlaybackEnabled" Grid.Column="2" Content="{loc:Loc ComputerPlayback}" FontSize="12" Margin="10,0,6,0" Click="DeviceEnabled_Click" />
                            <ComboBox x:Name="PlaybackDevice" Grid.Column="3" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="28" Padding="5,3" SelectionChanged="Device_SelectionChanged" ToolTip="{loc:Loc DevicesHint}" AutomationProperties.Name="{loc:Loc PlaybackDevice}" />
                            </Grid>
                            <WrapPanel x:Name="CaptureCommands" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="RefreshDevicesButton" Content="{loc:Loc RefreshList}" Click="RefreshDevices_Click" Padding="7,4" MinHeight="30" FontSize="12" Margin="6,0,0,0" />
                            <CheckBox x:Name="LiveTextCheck" Content="{loc:Loc LiveText}" FontSize="12" Margin="9,0,9,0" ToolTip="{loc:Loc LiveTextTooltip}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse x:Name="RecordingDot" Width="14" Height="14" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,5,0" />
                                <TextBlock x:Name="RecorderStatus" Text="{loc:Loc StateReady}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="StartButton" Content="{loc:Loc StartRecording}" Style="{StaticResource PrimaryButton}" Click="Start_Click" Padding="10,4" MinHeight="30" FontSize="12" />
                            <Button x:Name="StopButton" Content="{loc:Loc Stop}" Click="Stop_Click" Margin="6,0,0,0" Padding="10,4" MinHeight="30" FontSize="12" />
                            </WrapPanel>
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,5,0,0">
                            <TextBlock x:Name="SavedStatus" DockPanel.Dock="Left" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="AudioHealth" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
                            <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="1" Height="4" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Background="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0" AutomationProperties.Name="{loc:Loc MixedAudioLevel}" />
                        </DockPanel>
                    </Grid>
                </Border>
                <Grid x:Name="ReadingWorkspace" Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="0" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="TranscriptCard" Style="{StaticResource Card}" Padding="10">
                        <DockPanel>
                            <DockPanel x:Name="TranscriptHeader" DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button x:Name="PanelsButton" DockPanel.Dock="Right" Content="{loc:Loc ShowPanels}" Click="ShowPanels_Click"
                                        Visibility="Collapsed" MinHeight="22" Padding="6,1" FontSize="11" Margin="6,0,0,0"
                                        ToolTip="{loc:Loc ShowPanelsHint}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MainPointsPanelMenu" Header="{loc:Loc MainPoints}" Tag="summary" IsCheckable="True"
                                                      StaysOpenOnClick="True" Click="PaneVisibility_Click" />
                                            <MenuItem x:Name="MyNotesPanelMenu" Header="{loc:Loc MyNotes}" Tag="notes" IsCheckable="True"
                                                      StaysOpenOnClick="True" Click="PaneVisibility_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock x:Name="TranscriptTitle" DockPanel.Dock="Left" Text="{loc:Loc Transcript}"
                                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTipService.ShowDuration="60000" />
                                <WrapPanel x:Name="TranscriptActions" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="TranscribeButton" Content="{loc:Loc TranscribeResume}" Click="Transcribe_Click" FontSize="11" Padding="6,3" MinHeight="26" Margin="0,0,5,0" />
                                    <Button x:Name="IdentifySpeakersButton" Content="{loc:Loc IdentifySpeakers}" Click="IdentifySpeakers_Click" FontSize="11" Padding="6,3" MinHeight="26" Margin="0,0,5,0" />
                                    <Button x:Name="RestoreSilenceButton" Content="{loc:Loc RestoreMutedSections}" Click="RestoreSilence_Click" FontSize="11" Padding="6,3" MinHeight="26" Margin="0,0,5,0" />
                                    <Button x:Name="CancelAiButton" Content="{loc:Loc CancelAi}" Click="CancelAi_Click" FontSize="11" Padding="6,3" MinHeight="26" />
                                </WrapPanel>
                            </DockPanel>
                            <controls:TranscriptView x:Name="TranscriptPanel" />
                        </DockPanel>
                    </Border>
                    <GridSplitter x:Name="ReadingDivider" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Style="{StaticResource PaneDivider}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="{loc:Loc ResizePanels}" />
                    <Grid x:Name="NotesPane" Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
                        <Border x:Name="MainPointsCard" Style="{StaticResource Card}" Padding="10">
                            <DockPanel>
                                <DockPanel x:Name="MainPointsHeader" DockPanel.Dock="Top" Margin="0,0,0,5">
                                    <Button x:Name="CloseMainPointsButton" DockPanel.Dock="Right" Content="X" Tag="summary" Click="ClosePane_Click"
                                            Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="{loc:Loc HideMainPoints}" AutomationProperties.Name="{loc:Loc HideMainPoints}" />
                                    <WrapPanel x:Name="MainPointsActions" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <Button x:Name="SummarizeButton" Content="{loc:Loc UpdateMainPoints}" Click="Summarize_Click" FontSize="11" Padding="6,3" MinHeight="26" />
                                    </WrapPanel>
                                    <TextBlock x:Name="MainPointsTitle" Text="{loc:Loc MainPoints}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000" />
                                </DockPanel>
                                <TextBox x:Name="SummaryBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Padding="0,3" VerticalContentAlignment="Top" FontSize="13" AutomationProperties.Name="{loc:Loc ConversationMainPoints}" />
                            </DockPanel>
                        </Border>
                        <GridSplitter x:Name="NotesDivider" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource PaneDivider}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="{loc:Loc ResizePanels}" />
                        <Border x:Name="PersonalNotesCard" Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                            <DockPanel>
                                <DockPanel x:Name="MyNotesHeader" DockPanel.Dock="Top" Margin="0,0,0,5">
                                    <Button x:Name="CloseMyNotesButton" DockPanel.Dock="Right" Content="X" Tag="notes" Click="ClosePane_Click"
                                            Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="{loc:Loc HideMyNotes}" AutomationProperties.Name="{loc:Loc HideMyNotes}" />
                                    <WrapPanel x:Name="MyNotesActions" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <Button x:Name="UpdateMyNotesButton" Content="{loc:Loc UpdateMyNotes}" Click="UpdateMyNotes_Click"
                                                FontSize="11" Padding="6,3" MinHeight="26" ToolTip="{loc:Loc UpdateMyNotesHint}"
                                                ToolTipService.ShowOnDisabled="True" />
                                    </WrapPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="MyNotesTitle" DockPanel.Dock="Left" Text="{loc:Loc MyNotes}" Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000" />
                                        <TextBlock x:Name="NotesSaveState" services:MessageJournal.Reason="{loc:Loc MyNotes}" Text="{loc:Loc NotesAutoSaved}"
                                                   Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </DockPanel>
                                </DockPanel>
                                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" SpellCheck.IsEnabled="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                         Padding="0,3" VerticalContentAlignment="Top" TextChanged="Notes_TextChanged" AutomationProperties.Name="{loc:Loc PersonalNotes}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,1,0,0" Padding="14,5" SizeChanged="StatusBar_SizeChanged">
            <Border.ContextMenu>
                <ContextMenu x:Name="StatusBarMenu" Opened="StatusBarMenu_Opened">
                    <MenuItem x:Name="MessageHistoryMenu" Header="{loc:Loc MessageHistory}" Click="MessageHistory_Click" />
                    <Separator />
                    <MenuItem Header="{loc:Loc StatusBarInformation}" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="{loc:Loc StatusMessagesOption}" Tag="Messages" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                    <MenuItem Header="{loc:Loc StatusLlmOption}" Tag="Llm" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                    <MenuItem Header="{loc:Loc StatusSpeechOption}" Tag="SpeechModel" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                    <MenuItem Header="{loc:Loc StatusLibrarySizeOption}" Tag="LibrarySize" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                    <MenuItem Header="{loc:Loc StatusRecordingCountOption}" Tag="RecordingCount" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                    <MenuItem Header="{loc:Loc StatusFreeDiskOption}" Tag="FreeDiskSpace" IsCheckable="True" StaysOpenOnClick="True" Click="StatusOption_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
                <Border x:Name="WarningBanner" Visibility="Collapsed" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="7" Padding="8,4" Margin="0,0,0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:Loc MessageHistory}" Click="MessageHistory_Click" FontSize="11"
                                Padding="6,2" MinHeight="24" Margin="8,0,0,0" />
                        <Button x:Name="DismissErrorButton" DockPanel.Dock="Right" Content="{loc:Loc Dismiss}" Click="DismissWarning_Click" FontSize="11" Padding="6,2" MinHeight="24" Margin="8,0,0,0" />
                        <StackPanel>
                            <TextBlock x:Name="WarningStampText" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" MaxHeight="48" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel x:Name="ProcessingIndicator" Visibility="Collapsed" Margin="0,0,0,4">
                    <TextBlock x:Name="ProcessingLabel" DockPanel.Dock="Left" MaxWidth="250" FontSize="11" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ProcessingTimingText" DockPanel.Dock="Right" Visibility="Collapsed" MaxWidth="290"
                               FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{loc:Loc ProcessingTiming}" />
                    <ProgressBar x:Name="ProcessingProgress" Minimum="0" Maximum="1" Height="6" VerticalAlignment="Center"
                                 Background="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0"
                                 ToolTip="{loc:Loc ProcessingStagesHint}"
                                 AutomationProperties.Name="{loc:Loc ProcessingProgress}" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel x:Name="StatusIndicators" Grid.Column="1" HorizontalAlignment="Right">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Setter Property="MaxWidth" Value="300" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </WrapPanel.Resources>
                        <TextBlock x:Name="SpeechModelStatusText" />
                        <TextBlock x:Name="ModelStatusText" />
                        <TextBlock x:Name="LibrarySizeStatusText" Visibility="Collapsed" />
                        <TextBlock x:Name="RecordingCountStatusText" Visibility="Collapsed" />
                        <TextBlock x:Name="FreeDiskStatusText" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Text="{loc:Loc ReadyStatus}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"
                               MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
