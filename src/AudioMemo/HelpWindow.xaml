<Window x:Class="AudioMemo.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioMemo.Localization"
        xmlns:services="clr-namespace:AudioMemo.Services"
        Title="{loc:Loc HelpAndAbout}" Width="640" Height="440" MinWidth="420" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Button x:Name="CloseHelpButton" DockPanel.Dock="Bottom" Content="{loc:Loc Close}" IsCancel="True"
                IsDefault="True" MinWidth="80" HorizontalAlignment="Right" Margin="0,14,0,0" />
        <ScrollViewer x:Name="HelpDetails" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <DockPanel Margin="0,0,0,8">
                    <Image x:Name="AboutLogo" DockPanel.Dock="Left" Source="{x:Static services:AppIcons.Artwork}"
                           Width="64" Height="64" Margin="0,0,14,0" Stretch="Uniform" AutomationProperties.Name="AudioMemo" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc HelpAndAbout}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{loc:Loc AboutAudioMemo}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                <Border x:Name="CopyrightCard" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="AboutCopyright" Text="{loc:Loc AboutCopyright}" FontSize="18"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="AboutCredits" Text="{loc:Loc AboutCredits}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock x:Name="AboutThirdParty" Text="{loc:Loc AboutThirdParty}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <WrapPanel x:Name="HelpLinks" Margin="0,14,0,0">
                    <Button x:Name="UserGuideButton" Content="{loc:Loc UserGuide}" Click="UserGuide_Click" Margin="0,0,8,8" />
                    <Button x:Name="ShortcutsButton" Content="{loc:Loc HelpAndShortcuts}" Click="Shortcuts_Click" Margin="0,0,8,8" />
                    <Button x:Name="MessageHistoryButton" Content="{loc:Loc MessageHistory}" Click="MessageHistory_Click" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
