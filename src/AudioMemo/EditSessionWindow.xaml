<Window x:Class="AudioMemo.EditSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioMemo.Localization"
        xmlns:services="clr-namespace:AudioMemo.Services"
        Title="{loc:Loc EditSessionTitle}" Width="680" Height="660" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="RestoreRangeTemplate">
            <DockPanel Margin="2,3">
                <Button DockPanel.Dock="Right" Content="{loc:Loc PlayMutedRow}" Click="PlayMutedRow_Click"
                        Padding="7,2" MinHeight="24" FontSize="11" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Focusable="False" IsHitTestVisible="False"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Text="{Binding Text}" FontFamily="Segoe UI" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="36" Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Text}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="{loc:Loc EditSessionTitle}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="OriginalPolicyText" Text="{loc:Loc EditOriginalPreserved}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel x:Name="SaveChoicePanel" Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc MuteSaveChoice}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <RadioButton x:Name="EditInPlaceChoice" Content="{loc:Loc MuteCurrentRecording}" GroupName="SaveMode"
                                     Checked="SaveMode_Changed" Margin="0,6,0,0" />
                        <RadioButton x:Name="CreateCopyChoice" Content="{loc:Loc MuteNewCopy}" GroupName="SaveMode"
                                     Checked="SaveMode_Changed" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Loc MuteRecoveryBackupHint}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="NewCopyFields" Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Loc EditedCopyName}" Margin="0,0,0,5" />
                        <TextBox x:Name="TitleInput" MaxLength="160" AutomationProperties.Name="{loc:Loc EditedCopyName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc AudioFormat}" Margin="0,0,0,5" />
                        <ComboBox x:Name="FormatBox" AutomationProperties.Name="{loc:Loc AudioFormat}">
                            <ComboBoxItem Content="WAV" /><ComboBoxItem Content="MP3" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatisticsText" Grid.Row="2" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,10" />
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock x:Name="RangesLabelText" Text="{loc:Loc MutedRangesLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectionHintText" Text="{loc:Loc EditSelectionWarning}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" />
                    <WrapPanel x:Name="RestoreSelectionButtons" Visibility="Collapsed" Margin="0,6,0,0">
                        <Button x:Name="RestoreAllButton" Content="{loc:Loc SelectAllRestore}" Click="SelectAllRestore_Click" Padding="8,3" MinHeight="26" FontSize="12" />
                        <Button x:Name="ClearRestoreButton" Content="{loc:Loc ClearRestoreSelection}" Click="ClearRestoreSelection_Click" Padding="8,3" MinHeight="26" FontSize="12" Margin="6,0,0,0" />
                    </WrapPanel>
                </StackPanel>
                <ListBox x:Name="RangesList" Grid.Row="4" FontFamily="Cascadia Mono, Consolas" FontSize="12" MinHeight="96" MaxHeight="240"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc MutedRangesLabel}"
                         SelectionChanged="RestoreSelectionChanged" />
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <DockPanel x:Name="MutedReplayTransport" Visibility="Collapsed" Margin="0,0,0,8">
                        <Button x:Name="MutedReplayPause" DockPanel.Dock="Left" Content="{loc:Loc ReplayPause}" Click="MutedReplayPause_Click"
                                MinHeight="26" Padding="7,3" Margin="0,0,5,0" />
                        <Button DockPanel.Dock="Left" Content="{loc:Loc ReplayStop}" Click="MutedReplayStop_Click" MinHeight="26" Padding="7,3" Margin="0,0,8,0" />
                        <TextBlock x:Name="MutedReplayPosition" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" />
                        <Slider x:Name="MutedReplayProgress" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                ValueChanged="MutedReplaySeek_Changed" AutomationProperties.Name="{loc:Loc ReplayProgressLabel}" />
                    </DockPanel>
                    <TextBlock x:Name="SummaryPolicyText" Text="{loc:Loc EditedSummaryPolicy}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RebuildTranscriptWarning" Text="{loc:Loc RestoreRebuildWarning}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" Visibility="Collapsed" Margin="0,5,0,0" />
                    <TextBlock x:Name="EmptyTranscriptWarning" Text="{loc:Loc EditEmptyTranscriptWarning}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" Visibility="Collapsed" Margin="0,5,0,0" />
                    <ProgressBar x:Name="EditProgress" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,6"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" AutomationProperties.Name="{loc:Loc EditProgressLabel}" />
                    <TextBlock x:Name="StatusText" services:MessageJournal.Reason="{loc:Loc EditSessionTitle}" TextWrapping="Wrap" MaxHeight="72" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CreateButton" Content="{loc:Loc CreateEditedCopy}" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Create_Click" />
            <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" Click="Cancel_Click" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
