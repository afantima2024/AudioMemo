<Window x:Class="AudioMemo.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioMemo.Localization"
        Title="{loc:Loc HelpAndShortcuts}" Width="760" Height="680" MinWidth="420" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Button x:Name="CloseShortcutsButton" DockPanel.Dock="Bottom" Content="{loc:Loc Close}" IsCancel="True"
                IsDefault="True" MinWidth="80" HorizontalAlignment="Right" Margin="0,14,0,0" />
        <ScrollViewer x:Name="ShortcutDetails" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc HelpAndShortcuts}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <TextBlock Text="{loc:Loc ShortcutHelpHint}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                <TextBlock Text="{loc:Loc HistorySelectionHint}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                <ItemsControl x:Name="ShortcutHelpGrid">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1" Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Scope}" Style="{StaticResource MutedText}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayGesture}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
