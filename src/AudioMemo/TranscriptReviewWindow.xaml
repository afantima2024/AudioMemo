<Window x:Class="AudioMemo.TranscriptReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioMemo.Localization"
        xmlns:services="clr-namespace:AudioMemo.Services"
        Title="{loc:Loc ReviewUnclearTranscript}" Width="1180" Height="720" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <ScrollViewer x:Name="ReviewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid MinWidth="700" MinHeight="580" Width="{Binding ViewportWidth, ElementName=ReviewScroller}"
              Height="{Binding ViewportHeight, ElementName=ReviewScroller}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc ReviewUnclearTranscript}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc TranscriptReviewHint}" Style="{StaticResource MutedText}" Margin="0,6,0,6" />
            <TextBlock x:Name="ReviewCaption" TextWrapping="Wrap" />
            <TextBlock x:Name="ReviewModel" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>
        <Border x:Name="ReviewWarningPanel" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReviewWarning" TextWrapping="Wrap"
                           services:MessageJournal.Reason="{loc:Loc ReviewUnclearTranscript}" />
            </ScrollViewer>
        </Border>
        <DataGrid x:Name="ReviewRows" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  CellStyle="{StaticResource TranscriptDataGridCell}" SelectionChanged="Selection_Changed"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="{loc:Loc ReviewUnclearTranscript}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:Loc TranscriptReviewCorrect}" Width="82">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ApplyCorrection, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4"
                                      AutomationProperties.Name="{loc:Loc TranscriptReviewCorrect}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc TimestampColumn}" Binding="{Binding Time}" IsReadOnly="True" Width="160" />
                <DataGridTextColumn Header="{loc:Loc SpeakerColumn}" Binding="{Binding Speaker}" IsReadOnly="True" Width="95" />
                <DataGridTemplateColumn Header="{loc:Loc OriginalTranscriptText}" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding OriginalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="4"
                                     AutomationProperties.Name="{loc:Loc OriginalTranscriptText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Loc TranscriptReviewReason}" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Reason, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="4"
                                     AutomationProperties.Name="{loc:Loc TranscriptReviewReason}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc CorrectedTranscriptText}"
                                    Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="4" />
                            <Setter Property="MaxHeight" Value="180" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="AcceptsReturn" Value="True" />
                            <Setter Property="MaxLength" Value="16000" /><Setter Property="MaxHeight" Value="220" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,12">
            <WrapPanel>
                <Button x:Name="ReviewPlayButton" Content="{loc:Loc PlaySelectedRange}" Click="Play_Click" Margin="0,0,8,6" />
                <Button x:Name="ReviewPauseButton" Content="{loc:Loc ReplayPauseResume}" Click="Pause_Click" Margin="0,0,8,6" />
                <Button x:Name="ReviewStopButton" Content="{loc:Loc ReplayStop}" Click="Stop_Click" Margin="0,0,8,6" />
                <Button x:Name="ReviewAgainButton" Content="{loc:Loc TranscriptReviewAgain}" Click="Recheck_Click" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock x:Name="ReviewStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       services:MessageJournal.Reason="{loc:Loc ReviewUnclearTranscript}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="ApplyReviewButton" Content="{loc:Loc TranscriptReviewApply}" Style="{StaticResource PrimaryButton}"
                    Click="Apply_Click" Margin="0,0,8,6" />
            <Button x:Name="KeepReviewButton" Content="{loc:Loc TranscriptReviewKeep}" Click="Keep_Click" Margin="0,0,8,6" />
            <Button x:Name="CancelReviewButton" Content="{loc:Loc Cancel}" Click="Cancel_Click"
                    ToolTip="{loc:Loc TranscriptReviewCancelHint}" Margin="0,0,0,6" />
        </WrapPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
